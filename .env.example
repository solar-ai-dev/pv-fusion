# Template only. Do not commit real secrets.
# Copy to .env for Docker Compose local infra and app profile execution.
# Backend and AI Worker also keep service-specific .env.example files for standalone runs.

# Compose app profile ports / build args
FRONTEND_PORT=5173
SERVER_PORT=8080
AI_WORKER_PORT=8000
VITE_API_BASE_URL=http://localhost:8080/api/v1

# PostgreSQL Docker
POSTGRES_DB=pv_fusion_local
POSTGRES_USER=pvfusion
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Google OAuth2 for Backend local profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=<set-in-secret>
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
OAUTH2_SUCCESS_REDIRECT_URL=
OAUTH2_FAILURE_REDIRECT_URL=

# MinIO local object storage
# Backend local profile uses localhost because it runs on the host machine.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Docker Compose internal services use the compose service name.
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change_me_minio_root_password
MINIO_BUCKET_NAME=pv-insight-local
MINIO_REGION=ap-northeast-2

# LocalStack / SQS
SQS_ENDPOINT=http://localhost:4566
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test
SQS_REGION=ap-northeast-2
SQS_QUEUE_NAME=analysis-job-queue
SQS_QUEUE_URL=http://localhost:4566/000000000000/analysis-job-queue

# AI Worker Compose runtime
# Compose uses this canonical URI directly to avoid rebuilding it in YAML.
# If the password contains reserved URI characters, encode it before setting the value.
AI_WORKER_DATABASE_URI=postgresql://pvfusion:change_me_postgres_password@postgres:5432/pv_fusion_local
AI_WORKER_MODEL_DIR=./ai-worker/models
