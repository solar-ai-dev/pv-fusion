# Template only. Do not commit real secrets.
# Copy to .env or use your local shell environment when running locally.

# PostgreSQL Docker
POSTGRES_DB=pv_fusion_local
POSTGRES_USER=pvfusion
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Google OAuth2 for Backend local profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_SUCCESS_REDIRECT_URL=
OAUTH2_FAILURE_REDIRECT_URL=

# MinIO local object storage
# Backend local profile uses localhost because it runs on the host machine.
MINIO_ENDPOINT=http://localhost:9000
# Docker Compose internal services use the compose service name.
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change_me_minio_root_password
MINIO_BUCKET_NAME=pv-insight-local
MINIO_REGION=ap-northeast-2

# LocalStack / SQS
SQS_ENDPOINT=
SQS_ACCESS_KEY=
SQS_SECRET_KEY=
SQS_REGION=ap-northeast-2
SQS_QUEUE_URL=
