# Environment and secrets
**/.env
**/.env.*
**/*.local
**/application-*.local.yml
**/application-*.local.yaml
**/application-*.local.properties
!**/.env.example

# Build outputs
**/build/
**/dist/
**/out/
**/target/
**/.gradle/
**/.vite/

# Packages, virtualenvs, caches
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.cache/

# Logs and temp files
**/logs/
**/log/
**/tmp/
**/temp/
**/*.log

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Model and training artifacts
**/*.pt
**/*.pth
**/*.onnx
**/*.engine
**/*.ckpt
**/*.h5
**/*.pkl
**/*.joblib
**/*.mlflow


# AI worker model and temp directories
ai-worker/models/*
!ai-worker/models/.gitkeep
ai-worker/tmp/*
!ai-worker/tmp/.gitkeep

# Kubernetes secret manifests
k8s/**/*secret*.yaml
k8s/**/*secret*.yml
