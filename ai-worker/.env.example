# Local-only defaults.
# These values intentionally match docker-compose.yml fallback values.
# Copy this file to .env.local before running AI Worker locally.
# Do not put production secrets, real OAuth secrets, or personal tokens here.

DATABASE_URI=postgresql://pvfusion:change_me_postgres_password@localhost:5432/pv_fusion_local

AWS_REGION=ap-northeast-2
SQS_QUEUE_URL=http://localhost:4566/000000000000/analysis-job-queue
SQS_ENDPOINT_URL=http://localhost:4566
SQS_WAIT_TIME_SECONDS=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=change_me_minio_root_user
STORAGE_SECRET_KEY=change_me_minio_root_password
STORAGE_DEFAULT_BUCKET=pv-insight-local

RGB_MODEL_MANIFEST_PATH=models/rgb/model-manifest.dev.yaml
THERMAL_MODEL_MANIFEST_PATH=models/thermal/model-manifest.dev.yaml