# AI Worker environment variable contract
# Copy to ai-worker/.env.local for local development.
# APP_ENV is the canonical environment selector. ENVIRONMENT remains an alias for compatibility.
# Do not put real production secrets or static AWS production credentials here.

# Shared
APP_ENV=local
AWS_REGION=ap-northeast-2
DATABASE_URI=postgresql://pvfusion:<set-in-secret>@localhost:5432/pv_fusion_local
SQS_QUEUE_URL=http://localhost:4566/000000000000/analysis-job-queue
SQS_WAIT_TIME_SECONDS=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
STORAGE_DEFAULT_BUCKET=pv-insight-local
RGB_MODEL_MANIFEST_PATH=models/rgb/model-manifest.dev.yaml
THERMAL_MODEL_MANIFEST_PATH=models/thermal/model-manifest.dev.yaml

# Local-only
SQS_ENDPOINT_URL=http://localhost:4566
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=change_me_minio_root_user
STORAGE_SECRET_KEY=<set-in-secret>
STORAGE_PATH_STYLE_ENABLED=true

# Production-only placeholders
# APP_ENV=prod
# DATABASE_URI=postgresql://pvfusion:<set-in-secret>@db.example.com:5432/pv_fusion
# SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/analysis-job-queue
# STORAGE_DEFAULT_BUCKET=example-bucket
# RGB_MODEL_MANIFEST_PATH=/models/rgb/model-manifest.yaml
# THERMAL_MODEL_MANIFEST_PATH=/models/thermal/model-manifest.yaml
