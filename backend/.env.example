# Backend environment variable contract
# Copy to backend/.env locally if needed, or inject the same keys from Compose/Jenkins/K3s.
# Do not put real secrets in this file.

# Shared
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
OAUTH2_SUCCESS_REDIRECT_URL=
OAUTH2_FAILURE_REDIRECT_URL=

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=<set-in-secret>

# Local database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pv_fusion_local
POSTGRES_USER=pvfusion
POSTGRES_PASSWORD=<set-in-secret>

# Local storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=<set-in-secret>
MINIO_BUCKET_NAME=pv-insight-local
MINIO_REGION=ap-northeast-2

# Local queue
SQS_ENDPOINT=http://localhost:4566
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test
SQS_REGION=ap-northeast-2
SQS_QUEUE_URL=http://localhost:4566/000000000000/analysis-job-queue

# Production-only placeholders
RDS_JDBC_URL=
RDS_USERNAME=
RDS_PASSWORD=<set-in-secret>
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=example-bucket
S3_PATH_STYLE_ACCESS_ENABLED=false
